{
  "$schema": "https://opencode.ai/config.json",
  "logLevel": "INFO",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.4-mini": { "name": "GPT-5.4 Mini" }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "tinyllama": { "name": "TinyLlama" },
        "phi3": { "name": "Phi-3" }
      }
    }
  },
  "model": "ollama/phi3",
  "small_model": "ollama/tinyllama",
  "default_agent": "build",
  "share": "manual",
  "snapshot": true,
  "autoupdate": true,
  "server": {
    "cors": [],
    "mdns": false,
    "port": 4096,
    "hostname": "127.0.0.1",
    "mdnsDomain": "opencode.local"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md",
    "ARCHITECTURE.md",
    "docs/opencode/full-stack-expert-rules.md"
  ],
  "skills": {
    "watcher": {
      "ignore": [
        "node_modules",
        "dist",
        ".git",
        "*.log",
        "drizzle/meta"
      ]
    }
  }
}
