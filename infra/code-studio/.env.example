# Code Studio — Environment Configuration
# Copy to .env and fill in values

# ── CODEDB (dedicated PostgreSQL database) ────────────────────────────────────
DATABASE_URL_CODEDB=postgresql://user:password@localhost:5432/codedb

# ── OpenCode Runtime ──────────────────────────────────────────────────────────
# Base URL for `opencode serve` (default: http://127.0.0.1:4096)
OPENCODE_SERVER_URL=http://127.0.0.1:4096

# HTTP Basic Auth password for OpenCode server mode
OPENCODE_SERVER_PASSWORD=

# ── Workspace ─────────────────────────────────────────────────────────────────
# Base directory for ephemeral job workspaces
CODE_STUDIO_WORKSPACE_ROOT=/tmp/code-studio-workspaces

# ── Optional ──────────────────────────────────────────────────────────────────
# Max concurrent jobs (default: 3)
CODE_STUDIO_MAX_CONCURRENT_JOBS=3

# Job timeout in seconds (default: 1800 = 30 minutes)
CODE_STUDIO_JOB_TIMEOUT_SECONDS=1800
