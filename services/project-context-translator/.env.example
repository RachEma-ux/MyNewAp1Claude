# Project Context Translator — Environment Configuration
#
# Copy to .env and fill in your values:  cp .env.example .env

# LLM Provider: openai | anthropic
PCT_LLM_PROVIDER=openai

# API Key (required)
PCT_LLM_API_KEY=sk-...

# Model name
PCT_LLM_MODEL=gpt-4o-mini

# Base URL (optional — only needed for custom/proxy endpoints)
# PCT_LLM_BASE_URL=https://api.openai.com/v1

# Max tokens for response
PCT_LLM_MAX_TOKENS=4096
