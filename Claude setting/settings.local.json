{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Task",
      "TaskCreate",
      "TaskUpdate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "Monitor",
      "Skill",
      "ToolSearch",
      "NotebookEdit",
      "EnterPlanMode",
      "ExitPlanMode",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList",
      "PushNotification",
      "RemoteTrigger",
      "AskUserQuestion"
    ],
    "ask": [],
    "deny": [
      "Read(/root/MyNewAp1Claude/.env)",
      "Read(/root/MyNewAp1Claude/.env.*)",
      "Read(/root/MyNewAp1Claude/secrets/**)",
      "Read(/root/MyNewAp1Claude/**/secrets/**)",
      "Edit(/root/MyNewAp1Claude/.env)",
      "Edit(/root/MyNewAp1Claude/.env.*)",
      "Edit(/root/MyNewAp1Claude/secrets/**)",
      "Edit(/root/MyNewAp1Claude/**/secrets/**)",
      "Write(/root/MyNewAp1Claude/.env)",
      "Write(/root/MyNewAp1Claude/.env.*)",
      "Write(/root/MyNewAp1Claude/secrets/**)",
      "Write(/root/MyNewAp1Claude/**/secrets/**)",
      "Bash(printenv)",
      "Bash(env)",
      "Bash(sudo *)",
      "Bash(chown / *)",
      "Bash(chmod 777 *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /root)"
    ]
  }
}
