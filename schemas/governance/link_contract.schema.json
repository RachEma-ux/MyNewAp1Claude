{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mynewap1claude.local/schemas/governance/link_contract.schema.json",
  "title": "Link Contract",
  "description": "Canonical governed availability contract used to connect platform blocks under explicit scope, policy, lifecycle, and evidence rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "source",
    "target",
    "link_type",
    "purpose",
    "exposure_mode",
    "scope",
    "conditions",
    "authority",
    "lifecycle",
    "governance",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^link_[A-Za-z0-9._:-]+$",
      "description": "Stable link identifier."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the contract payload."
    },
    "source": {
      "$ref": "#/$defs/linkEndpoint"
    },
    "target": {
      "$ref": "#/$defs/linkEndpoint"
    },
    "link_type": {
      "$ref": "#/$defs/linkType"
    },
    "purpose": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1000,
      "description": "Human-readable statement of why the link exists."
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "uniqueItems": true,
      "default": []
    },
    "exposure_mode": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exposureMode"
      }
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "conditions": {
      "$ref": "#/$defs/conditions"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "metadata": {
      "type": "object",
      "description": "Implementation-specific metadata that does not affect core contract validity.",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      },
      "default": {}
    }
  },
  "$defs": {
    "blockType": {
      "type": "string",
      "enum": [
        "user",
        "person",
        "worker",
        "manager",
        "team",
        "hr_role",
        "workspace_member",
        "workspace",
        "module",
        "tool",
        "workflow",
        "task",
        "runtime_context",
        "ai_type",
        "agent_definition",
        "agent_instance",
        "provider",
        "model",
        "ai_capability_profile",
        "role",
        "policy_pack",
        "approval_chain",
        "risk_class",
        "audit_stream",
        "evidence_set",
        "org_unit",
        "position",
        "data_projection",
        "custom"
      ]
    },
    "linkType": {
      "type": "string",
      "enum": [
        "identity",
        "membership",
        "assignment",
        "capability",
        "access",
        "execution",
        "oversight",
        "evidence"
      ]
    },
    "exposureMode": {
      "type": "string",
      "enum": [
        "discover",
        "read",
        "use",
        "assign",
        "operate",
        "approve",
        "govern"
      ]
    },
    "scopeKind": {
      "type": "string",
      "enum": [
        "self",
        "team",
        "workspace",
        "org_unit",
        "global",
        "custom"
      ]
    },
    "projectionMode": {
      "type": "string",
      "enum": [
        "projection",
        "masked",
        "summary",
        "metadata_only",
        "raw"
      ]
    },
    "riskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "sensitivityClass": {
      "type": "string",
      "enum": [
        "class1_low",
        "class2_controlled",
        "class3_sensitive",
        "class4_highly_restricted"
      ]
    },
    "auditMode": {
      "type": "string",
      "enum": ["standard", "sensitive", "strict"]
    },
    "environment": {
      "type": "string",
      "enum": ["dev", "staging", "prod", "sandbox", "governed"]
    },
    "conditionKind": {
      "type": "string",
      "enum": [
        "identity",
        "lifecycle",
        "role",
        "scope",
        "risk",
        "approval",
        "environment",
        "custom"
      ]
    },
    "operator": {
      "type": "string",
      "enum": [
        "eq",
        "neq",
        "in",
        "not_in",
        "contains",
        "intersects",
        "gt",
        "gte",
        "lt",
        "lte",
        "exists",
        "not_exists",
        "custom"
      ]
    },
    "approvalType": {
      "type": "string",
      "enum": ["none", "role_any", "role_all", "dual_control", "cross_role", "custom"]
    },
    "lifecycleStatus": {
      "type": "string",
      "enum": [
        "proposed",
        "pending_validation",
        "pending_approval",
        "approved",
        "active",
        "suspended",
        "expired",
        "revoked",
        "archived"
      ]
    },
    "actorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["user", "role", "team", "workspace", "system", "service"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "linkEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "$ref": "#/$defs/blockType"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "approvalRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "$ref": "#/$defs/approvalType"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true,
          "default": []
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "field", "operator"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/conditionKind"
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "operator": {
          "$ref": "#/$defs/operator"
        },
        "value": {
          "type": ["string", "number", "boolean", "null", "array", "object"]
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_kind", "projection_mode"],
      "properties": {
        "scope_kind": {
          "$ref": "#/$defs/scopeKind"
        },
        "workspace_id": {
          "type": ["string", "null"],
          "maxLength": 255,
          "default": null
        },
        "team_id": {
          "type": ["string", "null"],
          "maxLength": 255,
          "default": null
        },
        "org_unit_id": {
          "type": ["string", "null"],
          "maxLength": 255,
          "default": null
        },
        "worker_id": {
          "type": ["string", "null"],
          "maxLength": 255,
          "default": null
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "uniqueItems": true,
          "default": []
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true,
          "default": []
        },
        "data_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true,
          "default": []
        },
        "projection_mode": {
          "$ref": "#/$defs/projectionMode"
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_enabled", "allowed_environments", "approvals_required", "predicates"],
      "properties": {
        "module_enabled": {
          "type": "boolean",
          "default": true
        },
        "policy_pack": {
          "type": ["string", "null"],
          "maxLength": 255,
          "default": null
        },
        "lifecycle_state": {
          "type": ["string", "null"],
          "maxLength": 128,
          "default": null
        },
        "allowed_environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/environment"
          }
        },
        "approvals_required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/approvalRequirement"
          },
          "default": []
        },
        "predicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          },
          "default": []
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "approvers", "reviewers"],
      "properties": {
        "owner": {
          "$ref": "#/$defs/actorRef"
        },
        "approvers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actorRef"
          },
          "default": []
        },
        "reviewers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actorRef"
          },
          "default": []
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "effective_from", "review_every_days"],
      "properties": {
        "status": {
          "$ref": "#/$defs/lifecycleStatus"
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "effective_to": {
          "type": ["string", "null"],
          "format": "date-time",
          "default": null
        },
        "review_every_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_level", "sensitivity_class", "audit_mode", "deny_by_default", "segregation_of_duties"],
      "properties": {
        "risk_level": {
          "$ref": "#/$defs/riskLevel"
        },
        "sensitivity_class": {
          "$ref": "#/$defs/sensitivityClass"
        },
        "audit_mode": {
          "$ref": "#/$defs/auditMode"
        },
        "deny_by_default": {
          "type": "boolean",
          "const": true,
          "description": "Cross-domain link contracts must be deny-by-default."
        },
        "segregation_of_duties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_by", "approved_by", "evidence_refs"],
      "properties": {
        "created_by": {
          "$ref": "#/$defs/actorRef"
        },
        "approved_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actorRef"
          },
          "default": []
        },
        "audit_stream_id": {
          "type": ["string", "null"],
          "maxLength": 255,
          "default": null
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "uniqueItems": true,
          "default": []
        },
        "last_verified_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "default": null
        }
      }
    }
  }
}
