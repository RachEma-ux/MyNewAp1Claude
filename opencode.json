{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.4-mini": { "name": "GPT-5.4 Mini" }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "tinyllama": { "name": "TinyLlama" },
        "phi3": { "name": "Phi-3" }
      }
    }
  },
  "skills": {
    "project_instructions": [
      "CLAUDE.md",
      "AGENTS.md",
      "ARCHITECTURE.md"
    ],
    "watcher": {
      "ignore": [
        "node_modules",
        "dist",
        ".git",
        "*.log",
        "drizzle/meta"
      ]
    },
    "compaction": true
  }
}
