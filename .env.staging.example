# =============================================================
# .env.staging.example — staging runtime template (no secrets).
#
# Copy to .env.staging on a real staging host (or to .env.staging.local
# on a developer machine — both are gitignored). Replace every
# `replace-with-secret` placeholder with a value sourced from the
# secrets manager. NEVER commit a real .env.staging.
#
# This file is the source of truth for the env contract that
# scripts/staging/preflight.ts enforces. Adding a new key here
# obliges you to update the preflight too.
# =============================================================

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=staging
STAGING_APP_URL=http://localhost:3000

# ─── Databases ───────────────────────────────────────────────
# Per-DB DSNs — each module owns its own DB.
DATABASE_URL_MYNEWAP1CLAUDE=postgres://mynewap1claude:mynewap1claude_staging@localhost:5432/mynewap1claude
DATABASE_URL_ASDB=postgres://asdb:asdb_staging@localhost:5433/asdb
DATABASE_URL_RAGDB=postgres://ragdb:ragdb_staging@localhost:5434/ragdb
DATABASE_URL_WFDB=postgres://wfdb:wfdb_staging@localhost:5435/wfdb

# Default DSN consumed by drizzle-kit / dev tooling.
DATABASE_URL=${DATABASE_URL_MYNEWAP1CLAUDE}

# ─── Policy ──────────────────────────────────────────────────
OPA_URL=http://localhost:8181

# ─── Workers ─────────────────────────────────────────────────
GRAPHRAG_WORKER_URL=http://localhost:4101
DATA_ACQUISITION_WORKER_URL=http://localhost:4102
EXTERNAL_ORCHESTRATOR_URL=http://localhost:4103
SANDBOX_WF_WORKER_URL=http://localhost:4104
KGRA_SERVICE_URL=http://localhost:4105
REDIS_URL=redis://localhost:6379
WORKER_QUEUE_URL=redis://localhost:6379

# ─── Required secrets ────────────────────────────────────────
# These MUST come from the secrets manager. The staging:generate-secrets
# script (PR #91) produces dev-only random values for local-developer
# use. Real staging hosts must replace these with values from the
# secrets manager.
ENCRYPTION_KEY=replace-with-secret
SECRETS_ENCRYPTION_KEY=replace-with-secret
COOKIE_SECRET=replace-with-secret
JWT_SECRET=replace-with-secret

# ─── Optional external connectors ────────────────────────────
# Leave commented / empty unless real credentials are present.
# The preflight reports any unset external connector as BLOCKED
# rather than PASS.
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=

# ─── Mode flag ───────────────────────────────────────────────
TEST_MODE=staging-integration
